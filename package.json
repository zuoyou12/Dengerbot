      "@solidjs/vite-plugin": "3.0.0-next.51",
      "@solidjs/web": "2.0.0-rc.18",
      "@speed-highlight/core": "1.2.24",
      "@tailwindcss/vite": "4.3.3",
      "@testing-library/jest-dom": "7.0.1",
      "@types/node": "24.19.2",
      "class-variance-authority": "0.7.1",
      "fflate": "0.8.3",
      "jose": "6.2.13",
      "jsdom": "30.0.1",
      "katex": "0.19.0",
      "marked": "18.1.1",
      "mermaid": "12.2.0",
      "pdfjs-dist": "6.4.299",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "vitest": "4.1.12",
      "wrangler": "4.152.0",
      "yaml": "2.9.1",
      "zod": "4.6.7",
      "lucide-solid": "1.33.0",
      "solid-sonner": "0.3.2",
      "solid-recharts": "1.0.1",
      "qrcode": "^1.5.4",
      "@tanstack/virtual-core": "3.19.7",
      "effect": "4.0.6"
    }
  },
  "main": "./out/main/index.js",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "postinstall": "bun scripts/electron-dist-cache.ts restore && bun scripts/install-electron.ts && bun scripts/electron-dist-cache.ts save && bun scripts/stamp-install.ts",
    "status:build": "bun run --cwd apps/status build",
    "status:smoke": "bun scripts/status-page-smoke.ts",
    "remote:up": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml up -d --build",
    "remote:down": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml down",
    "remote:logs": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml logs -f remote-api coturn",
    "remote:check": "bun remote/scripts/check.ts",
    "remote:check:compose": "bun remote/scripts/check.ts --compose",
    "remote:env:validate": "cd remote && bin/dotenvx validate -f .env.production -fk .env.keys",
    "remote:update": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- bun remote/scripts/update.ts",
