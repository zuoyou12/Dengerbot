  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyou12/Dengerbot.git"
  },
  "bugs": {
    "url": "https://github.com/zuoyou12/Dengerbot/issues"
  },
  "homepage": "https://github.com/zuoyou12/Dengerbot#readme",
  "keywords": [
    "ai-agents",
    "bun",
    "claude-code",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
