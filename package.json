    "typecheck:status": "bun run --cwd apps/status typecheck",
    "typecheck": "bun run --parallel 'typecheck:*'",
    "lint": "biome check --max-diagnostics=none .",
    "i18n:check": "bun scripts/i18n-check.ts",
    "types:ratchet": "bun scripts/type-ratchet.ts",
    "format": "biome check --write --max-diagnostics=none .",
    "knip:check": "knip",
    "check:staged": "biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "test": "bun run test:desktop",
    "test:desktop": "vitest run",
    "test:changed": "git merge-base origin/main HEAD > /dev/null && vitest run --changed origin/main --maxWorkers=1",
    "test:related": "vitest related --run --maxWorkers=1",
    "test:durations": "bun scripts/test-durations.ts",
    "test:backend": "vitest run src/backend",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:browser-agent-session": "bun scripts/browser-agent-session-e2e.ts",
    "test:browser-profile-agents": "bun scripts/browser-profile-agents-e2e.ts",
    "test:browser:google-live": "bun scripts/browser-smoke.ts --google-live",
    "test:browser:whatsapp-live": "bun scripts/browser-smoke.ts --whatsapp-live",
    "test:browser:canva-live": "bun scripts/browser-smoke.ts --canva-live",
    "test:browser:framer-live": "bun scripts/browser-smoke.ts --framer-live",
    "test:sign-in-relay-paste": "bun scripts/sign-in-relay-paste-e2e.ts",
    "test:acp-mcp-shared-token": "bun scripts/acp-mcp-shared-token-e2e.ts",
    "test:pi-steer": "bun scripts/pi-steer-e2e.ts",
    "test:mcp-catalog": "bun scripts/mcp-catalog-smoke.ts",
    "test:mcp-oauth": "bun scripts/mcp-oauth-e2e.ts",
    "test:mcp-oauth-store": "bun scripts/mcp-oauth-store-e2e.ts",
    "test:mcp-tool-consent": "bun scripts/mcp-tool-consent-e2e.ts",
    "test:agent-mcp-tools": "bun scripts/agent-mcp-tools-e2e.ts",
    "test:agent-update-agents": "bun scripts/agent-update-agents-e2e.ts",
    "test:ui-blocks": "bun scripts/ui-blocks-e2e.ts",
    "test:composer-attachments": "bun scripts/composer-attachments-e2e.ts",
    "test:agent-api-keys": "bun scripts/agent-api-keys-e2e.ts",
    "test:workflow-model-steps": "bun scripts/workflow-model-steps-e2e.ts",
