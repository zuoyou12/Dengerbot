    "dev:cpu": "bun scripts/dev-automation/cli.ts cpu",
    "dev:memory": "bun scripts/dev-automation/cli.ts memory",
    "dev:bench": "tsx scripts/dev-automation/bench.ts",
    "dev:status": "bun scripts/dev-stack.ts status",
    "dev:verify": "bun scripts/dev-verify.ts",
    "dev:stop": "bun scripts/dev-stack.ts stop",
    "dev:forget": "bun scripts/dev-stack.ts forget",
    "dev:reset": "tsx scripts/reset-dev-state.ts",
    "analytics:backfill": "bun scripts/backfill-openpanel-identities.ts",
    "build": "electron-vite build",
    "voice:prepare": "bun scripts/prepare-voice.ts",
    "voice:prepare-runtime": "bun scripts/prepare-voice.ts --runtime-only",
    "build:remote-desktop-runtime": "bun scripts/build-remote-desktop-runtime.ts",
    "install:remote-desktop-runtime": "bun scripts/install-remote-desktop-runtime.ts",
    "prepare:remote-desktop-runtime": "bun scripts/prepare-remote-desktop-runtime.ts",
    "prepare:cua-driver": "bun scripts/install-cua-driver.ts",
