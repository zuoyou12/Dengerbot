{
  "name": "openbot",
  "productName": "Dengerbot",
  "desktopName": "dengerbot.desktop",
  "version": "0.0.01Preview",
  "description": "A local-first multi-agent desktop workspace powered by DeepSeek and custom API endpoints.",
