    "test:voice-speech": "bun scripts/voice-speech-smoke.ts",
    "test:voice-transcription": "bun scripts/voice-transcription-smoke.ts",
    "test:remote-desktop-runtime": "bun scripts/remote-desktop-runtime-smoke.ts",
