    "install:node-runtime": "bun scripts/install-node-runtime.ts",
    "prepare:dsh-runtime": "bun scripts/prepare-dsh-runtime.ts",
    "package:dsh-runtime": "bun scripts/package-dsh-runtime.ts",
    "pin:bun-runtime": "bun scripts/pin-bun-runtime.ts",
    "pin:cua-driver": "bun scripts/pin-cua-driver.ts",
    "verify:remote-desktop-runtime": "bun scripts/verify-remote-desktop-runtime.ts",
    "preview": "bun scripts/preview.ts",
    "storybook": "bun scripts/dev-storybook.ts",
    "build-storybook": "storybook build",
    "typecheck:node": "bun scripts/type-checker.ts --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "bun scripts/type-checker.ts --noEmit -p tsconfig.web.json",
    "typecheck:storybook": "bun scripts/type-checker.ts --noEmit -p tsconfig.storybook.json",
    "typecheck:brand": "bun run --cwd packages/brand typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
