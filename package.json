    "check": "bun run check:desktop && bun run test:desktop",
    "check:desktop": "bun run check:desktop:static && bun run test:browser",
    "check:desktop:static": "bun run check:ui && bun run lint && bun run desktop:typecheck && bun run build && bun run verify:preload",
    "desktop:typecheck": "bun run --parallel typecheck:node typecheck:renderer typecheck:contracts typecheck:brand typecheck:storybook",
    "check:ui": "bun scripts/ui-foundation-check.ts",
    "check:assets": "bun scripts/check-image-assets.ts",
    "check:doc-links": "bun scripts/check-doc-links.ts",
    "verify:preload": "bun scripts/verify-preload-bundle.ts",
    "package": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run prepare:cua-driver && bun run build && electron-builder --dir --mac --config.mac.identity=null --config.mac.notarize=false",
    "verify:package": "bun scripts/verify-macos-package.ts",
    "package:verify": "bun run package && bun run verify:package",
    "package:win": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts win32 x64 && bun run verify:remote-desktop-runtime --windows && bun scripts/install-cua-driver.ts win32 x64 && bun run build && electron-builder --dir --win --x64 --publish never",
    "verify:package:win": "bun scripts/verify-windows-package.ts",
    "package:linux": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts linux x64 && bun run verify:remote-desktop-runtime --linux && bun scripts/install-cua-driver.ts linux x64 && bun run build && electron-builder --dir --linux --x64 --publish never",
    "package:linux:arm64": "bun run voice:prepare-runtime && bun scripts/install-cua-driver.ts linux arm64 && bun run build && electron-builder --dir --linux --arm64 --publish never",
    "verify:package:linux": "bun scripts/verify-linux-package.ts",
    "package:linux:verify": "bun run package:linux && bun run verify:package:linux",
    "verify:update-artifacts": "bun scripts/verify-update-artifacts.ts",
    "package:win:verify": "bun run package:win && bun run verify:package:win",
    "dist:mac": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run prepare:cua-driver && bun run build && electron-builder --mac --config.mac.identity=null --config.mac.notarize=false",
    "dist:win": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts win32 x64 && bun run verify:remote-desktop-runtime --windows && bun scripts/install-cua-driver.ts win32 x64 && bun run install:node-runtime win32 x64 && bun run prepare:dsh-runtime win32 x64 && bun run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts linux x64 && bun run verify:remote-desktop-runtime --linux && bun scripts/install-cua-driver.ts linux x64 && bun run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:linux:arm64": "bun run voice:prepare-runtime && bun scripts/install-cua-driver.ts linux arm64 && bun run build && electron-builder --linux AppImage --arm64 --publish never",
    "dist:release": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run prepare:cua-driver && bun run build && electron-builder --mac --publish never",
    "typecheck:telemetry": "bun run --cwd packages/telemetry typecheck"
  },
