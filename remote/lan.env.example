# The environment `compose.lan.yaml` reads. Copy to `lan.env` and fill in:
#   docker compose -f remote/compose.lan.yaml --env-file remote/lan.env up -d

# The desktop's mobile-connect HTTP origin, e.g. http://192.168.1.10:47822. The Signal container
# validates tickets against its JWKS and treats it as the control plane.
REMOTE_CONTROL_PLANE_URL=

# One of the two, in this order of preference:
#   REMOTE_TICKET_JWKS_URL — the desktop serves its signing keys at /v1/signal-jwks.json, so this
#     is just the control-plane origin with that path appended. A key rotation (a fresh identity)
#     takes effect without touching this file.
#   REMOTE_TICKET_PUBLIC_JWKS — the JWKS JSON inline, copied from
#     `%APPDATA%\Dengerbot Dev wt-…\mobile-connect\signal-ticket-jwks.json` (or the release
#     profile's). Static: a new identity means updating this value.
REMOTE_TICKET_JWKS_URL=
REMOTE_TICKET_PUBLIC_JWKS=

# `openssl rand -base64 32` for each. The webhook secret must equal the desktop's
# DENGERBOT_REMOTE_WEBHOOK_SECRET when one is set.
REMOTE_SESSION_SECRET=
REMOTE_AUTH_WEBHOOK_SECRET=

# The coturn shared secret, and the LAN address phones reach for TURN relays.
TURN_SHARED_SECRET=
TURN_PUBLIC_IP=

# Optional overrides; the defaults match the desktop's expectations.
# REMOTE_SIGNAL_PORT=8088
# REMOTE_HEALTH_PORT=8089
# TURN_REALM=lan
